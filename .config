# Shared application configuration for both backend and frontend

APP_HOST=192.168.100.10
API_PREFIX=/api

# Backend HTTP / WebSocket
BACKEND_PORT=3000
BACKEND_PUBLIC_BASE=http://192.168.100.10:3000
#BACKEND_PUBLIC_BASE=http://localhost:3000

# Frontend dev / preview
FRONTEND_DEV_HOST=192.168.100.10
#FRONTEND_DEV_HOST=localhost
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_PORT=4173
FRONTEND_PROXY_TARGET=http://192.168.100.10:3000

# Frontend runtime endpoints
FRONTEND_API_BASE=http://localhost:3000
# FRONTEND_API_BASE=https://cireniotapi.nakayamairon.com

#for Testing in local — was hardcoded to the production wss:// URL, which meant
#the local frontend's WebSocket always talked to the remote production backend
#(the one with ~43 days uptime) instead of this machine's own backend on :3000.
FRONTEND_WS_URL=ws://localhost:3000
# FRONTEND_WS_URL=wss://cireniotapi.nakayamairon.com

# Backend services
MONGO_URI=mongodb://admin:ciren4171@mongodb.nakayamairon.com:27017/ciren?authSource=admin
MQTT_HOST=118.22.31.254
MQTT_PORT=1883
# Distinct from production's client id — both connecting as "ciren-backend" made
# the MQTT broker kick whichever one connected first (duplicate ClientID),
# so local testing was silently stealing production's live data feed.
MQTT_CLIENT_ID=ciren-backend-local-dev

# Auth
JWT_SECRET=ciren--prod-secret-change-me
JWT_EXPIRES=7d
